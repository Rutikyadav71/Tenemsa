# === Stage 1: build the JAR ===
FROM maven:3.9.4-eclipse-temurin-21 AS build
WORKDIR /app
# Copy the build files first so the dependency download is cached until pom.xml changes.
COPY pom.xml .
RUN mvn -B -q dependency:go-offline
COPY src ./src
RUN mvn -B -q clean package -DskipTests

# === Stage 2: run it, as a non-root user ===
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S tenemsa && adduser -S tenemsa -G tenemsa
COPY --from=build /app/target/*.jar app.jar
USER tenemsa
EXPOSE 8080
# JAVA_OPTS lets you set memory, e.g. -Xmx512m, without rebuilding the image.
ENV JAVA_OPTS=""
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD wget -qO- "http://localhost:${PORT:-8080}/api/health" >/dev/null || exit 1
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]

# Copy this file to .env (or set these as real environment variables) and fill in values.
# Never commit an actual .env file — it should already be in .gitignore.

# --- Server ---
PORT=8080

# --- Database ---
# Which database to use: postgres (default) or mysql. Selects
# application-postgres.properties or application-mysql.properties.
SPRING_PROFILES_ACTIVE=postgres
DB_HOST=localhost
# PostgreSQL default port is 5432; MySQL is 3306.
DB_PORT=5432
DB_NAME=tenemsa
# PostgreSQL default user is "postgres"; MySQL is usually "root".
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# --- JWT (access tokens — short-lived, see refresh tokens below) ---
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION_MS=900000

# --- Refresh tokens (Phase 2) ---
# Opaque, hashed, revocable — not JWTs. See TokenService for why.
REFRESH_TOKEN_EXPIRATION_DAYS=30
REMEMBER_ME_EXPIRATION_DAYS=90
VERIFICATION_TOKEN_EXPIRATION_MINUTES=30

# --- Frontend URL ---
# Used to build links in emails (verification, password reset) and as the
# OAuth2 redirect target after Google login.
FRONTEND_URL=http://localhost:5173

# --- CORS ---
# Comma-separated list, no spaces. Add every frontend origin that needs to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://ry-ems.vercel.app

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Google OAuth2 (optional) ---
# Leave both blank to disable Google login entirely — the app starts up
# fine either way, see OAuth2ClientConfig for how that's handled safely.
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {your backend URL}/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Database schema (Flyway) ---
# Migrations run automatically at startup. Once every environment has started with Flyway
# at least once, switch Hibernate to validate-only:
DDL_AUTO=update
FLYWAY_ENABLED=true

# --- Rate limiting (public endpoints) ---
# Limits are per client IP. Leave RATE_LIMIT_TRUST_PROXY=false when the backend is
# reachable directly. Set it to true ONLY behind a reverse proxy that appends the
# client address to X-Forwarded-For (otherwise all users share the proxy's address).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false

# --- AI (Phase 6) ---
# AI is OFF by default. To turn it on, get a Gemini API key at https://aistudio.google.com/apikey
# and set AI_PROVIDER=google-genai. The key stays on the server and is never sent to the browser.
AI_PROVIDER=none
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Limits that protect your bill: requests per user per hour, per company per day, seconds to wait for the model.
AI_PER_USER_PER_HOUR=20
AI_PER_COMPANY_PER_DAY=300
AI_TIMEOUT_SECONDS=45

# --- Cloudinary ---
CLOUD_NAME=
API_KEY=
API_SECRET=

# --- AI cost estimate (optional, US dollars per million tokens; 0 hides the estimate) ---
AI_PRICE_INPUT_PER_MILLION_USD=0
AI_PRICE_OUTPUT_PER_MILLION_USD=0

# --- Knowledge base / RAG (Phase 7) ---
# Embeddings follow AI_PROVIDER and GEMINI_API_KEY by default. Uncomment to override.
# KB_EMBEDDING_PROVIDER=google-genai
# KB_EMBED_PER_COMPANY_PER_DAY=2000
# auto = pgvector on PostgreSQL when the extension exists, otherwise a portable scan. Or: pgvector | scan
# KB_VECTOR_STORE=auto
# Answers need passages at least this similar to the question (0 to 1).
# KB_MIN_SCORE=0.55

# --- Document storage (Phase 8b) ---
# Total size of stored documents per company, in bytes (default 200 MB).
# DOCUMENTS_MAX_COMPANY_BYTES=209715200

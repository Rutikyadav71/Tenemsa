# Copy to .env for local development (or .env.local — either works with Vite).
# Points the frontend at your local backend instead of the deployed one.
VITE_API_BASE_URL=http://localhost:8080

# --- Public site details (printed on the home page footer, Privacy, Terms and Contact) ---
# Leave empty until they exist; the pages say so instead of showing wrong details.
VITE_SUPPORT_EMAIL=
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_GOVERNING_LAW=India
# Privacy and Terms show a "not reviewed by a lawyer" notice until this is "true". Set it only after a lawyer has read them.
VITE_LEGAL_REVIEWED=false
VITE_APP_VERSION=

# Copy to .env next to docker-compose.yml. Never commit the real file.

# --- Required ---
DATABASE_PASSWORD=
JWT_SECRET=              # openssl rand -base64 64

# --- Addresses. For a real domain, use the public https addresses of the site and the API. ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Public pages (baked into the website at build time) ---
VITE_SUPPORT_EMAIL=
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_GOVERNING_LAW=India
VITE_LEGAL_REVIEWED=false   # set true only after a lawyer has reviewed Privacy and Terms
VITE_APP_VERSION=

# --- Optional: leave empty to keep a feature off ---
MAIL_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=
CLOUD_NAME=
API_KEY=
API_SECRET=
AI_PROVIDER=none
GEMINI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CONNECTIONS_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CONNECT_CLIENT_ID=
GOOGLE_CONNECT_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
